{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.17.0/schemas/schema.json",
  "services": [
    {
      "product": "ID Check",
      "component": "mobile-android-cri-orchestrator",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/lint.yml",
          "path": "$.jobs.lint"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/lint.yml",
          "path": "$.jobs.lint-structure"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/lint.yml",
          "path": "$.jobs.lint-github-actions"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.unit-test.steps[?@.id=='unit-tests']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "visual regression"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.unit-test.steps[?@.name=='Verify screenshots']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.unit-test.steps[?@.name=='Upload jars']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.assemble-instrumentation-tests"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.test-wrapper-instrumentation-test"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/workflows/test.yml",
          "path": "$.jobs.sonar-scan"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pr_metadata.yml",
          "path": "$.jobs.check-pr-title"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pr_metadata.yml",
          "path": "$.jobs.check-commit-messages"
        }
      ]
    }
  ]
}
