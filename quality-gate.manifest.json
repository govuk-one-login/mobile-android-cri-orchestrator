{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.11.0/schemas/schema.json",
  "services": [
    {
      "serviceTag": "id-check",
      "promotionType": "library",
      "checks": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint.yml",
            "path": "$.jobs.lint"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint.yml",
            "path": "$.jobs.lint-structure"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint.yml",
            "path": "$.jobs.lint-github-actions"
          }
        },
        {
          "checkTypes": [
            "unit",
            "integration",
            "regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.unit-test"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.assemble-instrumentation-tests"
          }
        },
        {
          "checkTypes": [
            "integration",
            "regression"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.test-wrapper-instrumentation-test"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "secret scanning",
            "unit test coverage",
            "vulnerability detection"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.sonar-scan"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pr_metadata.yml",
            "path": "$.jobs.check-pr-title"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pr_metadata.yml",
            "path": "$.jobs.check-commit-messages"
          }
        }
      ]
    }
  ]
}
