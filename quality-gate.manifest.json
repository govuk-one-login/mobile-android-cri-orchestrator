{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.15.0/schemas/schema.json",
  "services": [
    {
      "product": "ID Check",
      "component": "mobile-android-cri-orchestrator",
      "promotionType": "library",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint.yml",
            "path": "$.jobs.lint"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint.yml",
            "path": "$.jobs.lint-structure"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/lint.yml",
            "path": "$.jobs.lint-github-actions"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.unit-test.steps[?@.id=='unit-tests']"
          },
          "checks": [
            {
              "name": "unit"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.unit-test.steps[?@.name=='Verify screenshots']"
          },
          "checks": [
            {
              "name": "visual regression"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.unit-test.steps[?@.name=='Upload jars']"
          },
          "checks": [
            {
              "name": "code quality"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.assemble-instrumentation-tests"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.test-wrapper-instrumentation-test"
          },
          "checks": [
            {
              "name": "integration"
            },
            {
              "name": "regression"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/test.yml",
            "path": "$.jobs.sonar-scan"
          },
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "secret scanning"
            },
            {
              "name": "unit test coverage"
            },
            {
              "name": "vulnerability detection"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pr_metadata.yml",
            "path": "$.jobs.check-pr-title"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pr_metadata.yml",
            "path": "$.jobs.check-commit-messages"
          },
          "checks": [
            {
              "name": "code style and linting"
            }
          ]
        }
      ]
    }
  ]
}
