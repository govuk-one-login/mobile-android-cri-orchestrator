# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Deploy a new version to Firebase App Distribution"
  lane :distribute do |options|
    firebase_app_distribution(
        app: options[:app_id],
        service_credentials_file: options[:json_key],
        android_artifact_type: "AAB",
        android_artifact_path: options[:aab_path],
        testers: "chris.donnelly1@digital.cabinet-office.gov.uk, ctest7832@gmail.com",
        release_notes: "Release notes will go here",
        debug: true
    )
  end
end
