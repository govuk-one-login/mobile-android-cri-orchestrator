#!/usr/bin/env bash

FILE_CONTENT=$1
REGEX="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test){1}(\([[:alnum:]._-]+\))?(!)?: ([[:alnum:]])+([[:space:][:print:]]*)"

echo "Checking title '$FILE_CONTENT' conforms to conventional commit standards"

if [[ $FILE_CONTENT =~ $REGEX ]]; then
 echo "Valid commit '$FILE_CONTENT'"
else
  echo "Error: '$FILE_CONTENT' doesn't conform to conventional commit standards"
 exit 1
fi
