#!/usr/bin/env bash

pr_title=$1
conventional_commit_regex="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test){1}(\([\w\-\.]+\))?(!)?: ([\w ])+([\s\S]*)"

echo "Checking title ${pr_title} conforms to conventional commit standards"

[[ "${pr_title}" =~ conventional_commit_regex ]] || {
  echo "Error: ${pr_title} doesn't conform to conventional commit standards"
  exit 1
}
